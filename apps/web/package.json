{
  "name": "pluto-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "postbuild": "cp -R .next/static .next/standalone/.next/",
    "format:check": "prettier --check app components lib/api.ts tests *.ts *.json *.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/inter-tight": "^5.2.0",
    "hash-wasm": "4.12.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
